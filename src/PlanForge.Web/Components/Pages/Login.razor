@page "/login"
@page "/register"
@layout AuthLayout
@inject NavigationManager Navigation
<PageTitle>@T[IsRegister ? "Create account" : "Sign in"] · PlanForge</PageTitle>
<section class="auth-card">
	<div class="eyebrow">@T["YOUR NEXT STEP STARTS HERE"]</div>
	<h1>@T[IsRegister ? "Create your workspace" : "Welcome back"]<span class="accent">.</span></h1>
	<p class="muted">@T[IsRegister ? "One place for projects, agents and the work ahead." : "Pick up where you left off. Your plans are waiting."]</p>
	@if (Notice == "password-changed") { <div class="notice" role="status">@T["Your password was changed. Sign in again."]</div> }

	<form method="post" action="@(IsRegister ? "/account/register" : "/account/login")" data-enhance="false" data-registration="@(IsRegister ? "true" : null)">
		<AntiforgeryToken />
		@if (IsRegister) { <label>@T["Display name"]<input name="displayName" autocomplete="name" maxlength="80" required /></label> }
		<label>@T["Email address"]<input type="email" name="email" autocomplete="username" maxlength="256" required /></label>
		<label>@T["Password"]<input type="password" name="password" autocomplete="@(IsRegister ? "new-password" : "current-password")" minlength="12" maxlength="128" required aria-describedby='@(IsRegister ? "password-requirements" : null)' />@if (IsRegister) { <small id="password-requirements" class="muted">@T["Use 12–128 characters."]</small> }</label>
		@if (IsRegister)
		{
			<label for="confirm-password">@T["Confirm password"]
			<input id="confirm-password" type="password" name="confirmPassword" autocomplete="new-password" minlength="12" maxlength="128" required aria-invalid="@(PasswordMismatch ? "true" : null)" aria-describedby="@(PasswordMismatch ? "password-confirmation-error" : null)" /></label>
			<div id="password-confirmation-error" class="field-error" role="alert" hidden="@(!PasswordMismatch)">@T["Passwords do not match."]</div>
		}
		@if (!string.IsNullOrEmpty(Error)) { <div class="notice error" role="alert">@Error</div> }
		<button class="primary full" type="submit">@T[IsRegister ? "Create account" : "Sign in"] <span>→</span></button>
	</form>
	<p class="auth-switch">@T[IsRegister ? "Already have an account?" : "New to PlanForge?"] <a href="@(IsRegister ? "/login" : "/register")" data-enhance-nav="false">@T[IsRegister ? "Sign in" : "Create an account"]</a></p>
</section>
<div class="auth-caption"><span class="status-dot"></span> @T["Clear plans. Real progress. No lost context."]</div>
@code {
	[SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
	[SupplyParameterFromQuery(Name = "notice")] public string? Notice { get; set; }
	[SupplyParameterFromQuery(Name = "passwordMismatch")] public bool PasswordMismatch { get; set; }
	private bool IsRegister => new Uri(Navigation.Uri).AbsolutePath == "/register";
}
