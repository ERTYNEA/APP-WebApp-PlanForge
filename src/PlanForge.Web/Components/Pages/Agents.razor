@page "/agents"
@attribute [Authorize]
@inherits ApiPage
<PageTitle>@T["Agents"] · PlanForge</PageTitle>
<div class="page-heading"><div><div class="eyebrow">@T["YOUR COLLABORATORS"]</div><h1>@T["Agents"]<span class="accent">.</span></h1><p class="muted">@T["Logical identities for your work. No hosted execution, no invented online status."]</p></div><button class="primary" @onclick="() => OnEdit(null)" disabled="@Busy">@T["+ New agent"]</button></div>
<Feedback Error="@(showEditor || deleteId.HasValue ? null : Error)" Conflict="Conflict" Toasts="Toasts" />
@if(agents is null) { <p role="status">@T["Loading agents…"]</p> }
else if(agents.Count==0) { <section class="empty-state"><h2>@T["No agents yet"]</h2><p>@T["Create a logical identity to assign work and issue a personal API token."]</p></section> }
else
{
	<div class="agent-grid">@foreach(AgentProfile agent in agents) { <article class="agent-card" @key="agent.Id"><div class="card-top"><span class="avatar large">@if(agent.HasAvatar) { <img src="@($"/files/agent-avatars/{agent.Id}")" alt="" /> } else { @agent.Name[..1] }</span><span class="badge @(agent.IsActive ? "success" : "warning")">@T[agent.IsActive ? "Active" : "Inactive"]</span></div><h2>@agent.Name</h2><p class="muted user-text">@agent.Description</p><div class="card-footer"><span class="mono small">@agent.Id.ToString()[..8]</span><button class="quiet" @onclick="() => OnEdit(agent)" disabled="@Busy">@T["Edit"]</button></div></article> }</div>
}
@if(agents is not null) { <AgentTokenPanel Agents="agents" @ref="tokenPanel" /> }
@if(deleteId.HasValue) { <ConfirmDialog Title='@T["Delete agent?"]' ConfirmLabel='@T["Delete agent"]' Description='@T["Permanently delete {0}? This is irreversible. The agent profile, avatar and all its credentials will be removed and access will stop. Existing work and history are preserved; current assignments are detached.", deleteName]' Busy="Busy" Error="@Error" Close="() => { ClearFeedback(); deleteId=null; }" Confirm="OnDeleteAsync" /> }
@if(showEditor)
{
	<Modal Title="@(editingId.HasValue ? "Edit agent" : "New agent")" Error="@(avatarIncomplete ? null : Error)" Close="() => { ClearFeedback(); showEditor=false; }"><form id="agent-form" @onsubmit="OnSaveAsync" @onsubmit:preventDefault><label>@T["Name"]<input id="agent-name" @bind="name" required maxlength="80" /></label><label>@T["Description / role"]<textarea id="agent-description" @bind="description" maxlength="1000" rows="3"></textarea></label><label class="check-label"><input id="agent-active" type="checkbox" aria-describedby="agent-active-help" @bind="active" /> @T["Active (inactive agents cannot authenticate)"]</label><p id="agent-active-help" class="muted small">@T["Deactivating revokes linked tokens. Reactivating requires a new token; unlinked personal tokens are not affected."]</p><FormError Conflict="Conflict" /><div class="form-actions"><button type="button" class="quiet" @onclick="() => { ClearFeedback(); showEditor=false; }">@T["Cancel"]</button><button class="primary" disabled="@Busy">@T["Save agent"]</button></div></form>
	<AvatarEditor ExternalError="@(avatarIncomplete ? Error : null)" @ref="avatarEditor" Deferred="@(!editingId.HasValue)" ApiPath="@($"agents/{editingId}/avatar")" ImageUrl="@($"/files/agent-avatars/{editingId}")" HasAvatar="@(agents?.FirstOrDefault(agent=>agent.Id==editingId)?.HasAvatar ?? false)" Changed="OnAvatarChangedAsync" />
	@if(editingId.HasValue) { <div class="danger-zone"><button class="danger" @onclick="OnDelete">@T["Delete agent"]</button></div> }
	</Modal>
}
@code {
	private List<AgentProfile>? agents;
	private Guid? editingId;
	private string name="",description="";
	private bool active=true,showEditor,avatarIncomplete;
	private AgentTokenPanel? tokenPanel;
	private AvatarEditor? avatarEditor;
	private Guid? deleteId;
	private string deleteName = "";
	private void OnDelete() { deleteId=editingId; deleteName=name; showEditor=false; }
	private Task OnDeleteAsync() => ExecuteAsync(async () => { if(!deleteId.HasValue) return; await Api.SendAsync<object>(HttpMethod.Delete,$"agents/{deleteId}",new DeleteAgentRequest(true),cancellationToken:Token); deleteId=null; await LoadAsync(); if(tokenPanel is not null) await tokenPanel.RefreshAsync(); },"Agent deleted");
	protected override Task OnInitializedAsync() => ExecuteAsync(LoadAsync);
	private async Task LoadAsync() => agents=await Api.GetAsync<List<AgentProfile>>("agents",Token);
	private async Task OnAvatarChangedAsync() { await LoadAsync(); Error=null; avatarIncomplete=false; }
	private void OnEdit(AgentProfile? agent) { ClearFeedback(); avatarIncomplete=false; editingId=agent?.Id; name=agent?.Name ?? ""; description=agent?.Description ?? ""; active=agent?.IsActive ?? true; showEditor=true; }
	private Task OnSaveAsync() => ExecuteAsync(async () =>
	{
		bool creating = !editingId.HasValue;
		AgentProfile saved = await Api.SendAsync<AgentProfile>(editingId.HasValue ? HttpMethod.Put : HttpMethod.Post,"agents"+(editingId.HasValue ? $"/{editingId}" : ""),new AgentRequest(name,description,active),cancellationToken:Token);
		editingId = saved.Id;
		agents ??= [];
		int existingIndex=agents.FindIndex(agent=>agent.Id==saved.Id);
		if(existingIndex<0)
			agents.Add(saved);
		else
			agents[existingIndex]=saved;
		if(creating && avatarEditor is { HasPending: true })
		{
			try { await avatarEditor.UploadPendingAsync($"agents/{saved.Id}/avatar"); }
			catch (Exception exception) when (exception is PlanForge.Web.Api.ApiException or HttpRequestException or IOException or OperationCanceledException)
			{
				avatarIncomplete = true;
				Error=T["The agent was saved, but its avatar upload was not confirmed."].Value;
				return;
			}
		}
		showEditor=false; await LoadAsync(); Notify("Agent saved");
	});
}
