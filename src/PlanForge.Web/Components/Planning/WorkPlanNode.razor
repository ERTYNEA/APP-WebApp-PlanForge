<li class="plan-branch" data-item-id="@Item.Id">
	<div class="node-heading plan-row @(SelectedId == Item.Id ? "is-selected" : "")">
		@if (Children.Count > 0)
		{
			<button type="button" class="tree-expander" @onclick="() => Toggle.InvokeAsync(Item.Id)" aria-expanded="@Expanded.Contains(Item.Id).ToString().ToLowerInvariant()" aria-controls="@($"branch-{Item.Id}")" aria-label='@T["Toggle {0} {1}",T[Item.Kind.ToLowerInvariant()],Item.Title]'>@(Expanded.Contains(Item.Id) ? "⌄" : "›")</button>
		}
		else { <span class="tree-expander tree-leaf" aria-hidden="true">−</span> }
		<button type="button" class="tree-select" data-select-id="@Item.Id" @onclick="() => Select.InvokeAsync(Item.Id)" aria-current="@(SelectedId == Item.Id ? "true" : null)" title="@Item.Title"><span class="node-kind" aria-hidden="true">@(Item.Kind == "Phase" ? "▱" : Item.Kind == "Subphase" ? "◈" : "○")</span><span class="tree-title">@Item.Title</span></button>
		<span class="badge @PlanLabels.StatusClass(Item.EffectiveStatus)">@T[Item.EffectiveStatus]</span>
	</div>
	@if (Children.Count > 0 && Expanded.Contains(Item.Id))
	{
		<ul id="@($"branch-{Item.Id}")" class="tree-children">
			@foreach (PlanItem child in Children)
			{
				<WorkPlanNode @key="child.Id" Item="child" Snapshot="Snapshot" Expanded="Expanded" SelectedId="SelectedId" Toggle="Toggle" Select="Select" />
			}
		</ul>
	}
</li>
@code {
	[Parameter, EditorRequired] public PlanItem Item { get; set; } = default!;
	[Parameter, EditorRequired] public ProjectSnapshot Snapshot { get; set; } = default!;
	[Parameter] public HashSet<Guid> Expanded { get; set; } = [];
	[Parameter] public Guid? SelectedId { get; set; }
	[Parameter] public EventCallback<Guid> Select { get; set; }
	[Parameter] public EventCallback<Guid> Toggle { get; set; }
	private List<PlanItem> Children => Snapshot.Items.Where(item => item.ParentId == Item.Id && item.Kind != "Decision").OrderBy(item => item.SortOrder).ThenBy(item => item.Id).ToList();
}
