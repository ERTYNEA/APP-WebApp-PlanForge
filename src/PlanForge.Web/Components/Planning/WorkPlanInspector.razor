<section id="plan-inspector" class="panel plan-inspector" data-selected-id="@(Item?.Id ?? Snapshot.Id)" aria-label='@T["Selection details"]'>
	<nav class="selection-path" aria-label='@T["Selection path"]'>
		<ol>
			<li>@if (Item is null) { <span aria-current="page">@Snapshot.Name</span> } else { <button type="button" class="quiet compact" @onclick="() => Select.InvokeAsync(null)">@Snapshot.Name</button> }</li>
			@foreach (PlanItem node in SelectionPath)
			{
				<li>@if (node.Id == Item?.Id) { <span aria-current="page">@node.Title</span> } else { <button type="button" class="quiet compact" @onclick="() => Select.InvokeAsync(node.Id)">@node.Title</button> }</li>
			}
		</ol>
	</nav>
	<div class="section-label">@T[Item is null ? "Project" : Item.Kind.ToLowerInvariant()]</div>
	<h3 class="user-text">@(Item?.Title ?? Snapshot.Name)</h3>
	<div class="inspector-status">
		<span class="badge @PlanLabels.StatusClass(Item?.EffectiveStatus ?? Snapshot.Status)">@T[Item?.EffectiveStatus ?? Snapshot.Status]</span>
		<StatusDate Value="@(Item is null ? Snapshot.EffectiveStatusChangedAt : Item.EffectiveStatusChangedAt)" />
	</div>
	@if (Item is null || Item.Kind is "Phase" or "Subphase") { <p class="muted small calculated-status">@T["Status updates automatically as work progresses."]</p> }
	@if (!string.IsNullOrWhiteSpace(Description)) { <p class="user-text inspector-description">@Description</p> }
	<div class="inspector-metadata">
		@if (Item is null)
		{
			<p class="muted small">@PlanLabels.Workflow(Snapshot.Workflow)</p>
			<p>@T["{0}% complete",Snapshot.Progress] · @T["{0} / {1} steps",Snapshot.Items.Count(item => item.Kind == "Step" && item.EffectiveStatus == "Completed"),Snapshot.Items.Count(item => item.Kind == "Step")]</p>
			<p class="muted small">@T["Phases"]: @Snapshot.Items.Count(item => item.Kind == "Phase") · @T["Pending decisions"]: @Snapshot.Items.Count(item => item.Kind == "Decision" && item.Status == "Pending")</p>
		}
		else
		{
			@if (Snapshot.GetEffectiveAgentId(Item.Id) is Guid agentId)
			{
				<p class="agent-tag">@if (Agents.FirstOrDefault(agent => agent.Id == agentId)?.HasAvatar == true) { <img src="@($"/files/agent-avatars/{agentId}")" alt="" /> } @AgentName(agentId)</p>
			}
			else { <p class="muted small">@T["Agent assignment"]: @T[Item.AssignmentMode]</p> }
			@if (Item.Kind == "Step")
			{
				@if (Item.EffectiveStatus == "Blocked") { <p class="notice warning small">@T["Blocked by pending decisions on this step."] @T["Work status"]: @T[Item.Status]</p> }
				<p class="muted small">@PlanLabels.Status(Item, Snapshot.Workflow) · @PlanLabels.Workflow(Snapshot.Workflow)</p>
			}
			@if (Item.CompletedAt.HasValue) { <p class="muted small">@T["Recorded"] @Item.CompletedAt.Value.ToLocalTime().ToString("g") · @Item.Evidence · <span class="mono">@Item.CompletedBy</span></p> }
		}
	</div>
	<div class="inspector-actions">
		@if (Item is null)
		{
			<button type="button" class="quiet" @onclick="ProjectSettings" disabled="@Disabled">@T["Project settings"]</button>
			<button type="button" class="quiet" @onclick='() => Add.InvokeAsync(("Phase", null))' disabled="@Disabled">+ @T["Add phase"]</button>
		}
		else
		{
			<button type="button" class="quiet" @onclick="() => Edit.InvokeAsync(Item)" disabled="@Disabled" aria-label='@T["Edit {0} {1}",T[Item.Kind.ToLowerInvariant()],Item.Title]'>@T["Edit {0}",T[Item.Kind.ToLowerInvariant()]]</button>
			@if (Item.Kind is "Phase" or "Subphase") { <button type="button" class="quiet" @onclick='() => Add.InvokeAsync((Item.Kind == "Phase" ? "Subphase" : "Step", Item.Id))' disabled="@Disabled">+ @T[Item.Kind == "Phase" ? "Add subphase" : "Add step"]</button> }
			<button type="button" class="danger" @onclick="() => Delete.InvokeAsync(Item)" disabled="@Disabled">@T["Delete {0}",T[Item.Kind.ToLowerInvariant()]]</button>
		}
	</div>
	<section class="inspector-resources" aria-label='@T[(Item?.Kind ?? "Project") + " resources"]'>
		<div class="inspector-section-heading"><h4>@T[(Item?.Kind ?? "Project") + " resources"]</h4><button type="button" class="quiet compact" @onclick="() => AttachResources.InvokeAsync(Item?.Id ?? Snapshot.Id)" disabled="@Disabled">+ @T["Attach resources"]</button></div>
		@foreach (ResourceProfile resource in VisibleResources)
		{
			<div class="inspector-resource" data-resource-id="@resource.Id"><a href="@($"/files/resources/{resource.Id}")" data-enhance-nav="false">↧ @resource.FileName</a><div class="resource-origins">
				@foreach (ResourceOrigin origin in Origins(resource)) { <span class="muted small" data-origin-id="@origin.Id">@(origin.Id == (Item?.Id ?? Snapshot.Id) ? T["Direct"] : T["Inherited from {0}: {1}",origin.Kind,origin.Title])</span> }
			</div></div>
		}
		@if (VisibleResources.Count == 0) { <p class="muted small">@T["No resources here yet"]</p> }
	</section>
	<section class="inspector-decisions" aria-label='@T["Decisions"]'>
		<div class="inspector-section-heading"><h4>@T["Decisions"]</h4><button type="button" class="quiet compact" @onclick='() => Add.InvokeAsync(("Decision", Item?.Id ?? Snapshot.Id))' disabled="@Disabled">+ @T["Add decision"]</button></div>
		<p class="muted small">@T["Track questions and decisions that need resolution."]</p>
		@foreach (PlanItem decision in Snapshot.Items.Where(item => item.Kind == "Decision" && item.ParentId == (Item?.Id ?? Snapshot.Id)).OrderBy(item => item.SortOrder).ThenBy(item => item.Id))
		{
			<div class="inspector-decision">
				<div class="decision-heading"><strong class="user-text">@decision.Title</strong><span class="badge @PlanLabels.StatusClass(decision.Status)">@T[decision.Status]</span></div>
				@if (decision.Description.Length > 0) { <p class="user-text decision-description">@decision.Description</p> }
				@if (decision.Resolution.Length > 0) { <p class="decision-resolution user-text"><span class="section-label">@T["Resolution"]</span><br />@decision.Resolution</p> }
				<div class="toolbar"><button type="button" class="quiet compact" @onclick="() => Edit.InvokeAsync(decision)" disabled="@Disabled" aria-label='@T["Edit {0} {1}",T["decision"],decision.Title]'>@T["Edit decision"]</button><button type="button" class="danger compact" @onclick="() => Delete.InvokeAsync(decision)" disabled="@Disabled">@T["Delete decision"]</button></div>
			</div>
		}
	</section>
</section>
