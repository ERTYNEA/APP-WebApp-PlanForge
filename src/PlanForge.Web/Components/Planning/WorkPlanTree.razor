@inject IJSRuntime JavaScript
@inject PlanForge.Web.State.PlanExplorerState NavigationState
<div class="plan-explorer">
	<nav id="plan-structure" class="work-plan-tree" aria-label="@T["Hierarchical work plan"]">
		<ul class="tree-roots">
			<li data-item-id="@Snapshot.Id">
				<div class="node-heading plan-row @(SelectedId is null ? "is-selected" : "")"><span class="tree-expander tree-leaf" aria-hidden="true">▦</span><button type="button" class="tree-select" @onclick="() => OnManualSelect(null)" aria-current="@(SelectedId is null ? "true" : null)" title="@Snapshot.Name"><span class="tree-title">@Snapshot.Name</span></button><span class="badge @PlanLabels.StatusClass(Snapshot.Status)">@T[Snapshot.Status]</span></div>
				<ul class="tree-children">
					@foreach (PlanItem phase in Snapshot.Items.Where(item => item.Kind == "Phase").OrderBy(item => item.SortOrder).ThenBy(item => item.Id))
					{
						<WorkPlanNode @key="phase.Id" Item="phase" Snapshot="Snapshot" Expanded="Expanded" SelectedId="SelectedId" Toggle="OnToggle" Select="id => OnManualSelect(id)" />
					}
				</ul>
			</li>
		</ul>
	</nav>
	<WorkPlanInspector Snapshot="Snapshot" Item="Selected" Agents="Agents" Resources="Resources" Edit="Edit" Add="Add" Delete="Delete" AttachResources="AttachResources" ProjectSettings="ProjectSettings" Select="OnManualSelect" Disabled="Disabled" />
</div>
