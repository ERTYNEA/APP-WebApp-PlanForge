<div class="work-plan-tree" aria-label="@T["Hierarchical work plan"]">
	@foreach (PlanItem phase in Snapshot.Items.Where(item => item.Kind == "Phase").OrderBy(item => item.SortOrder))
	{
		<WorkPlanNode @key="phase.Id" Item="phase" Snapshot="Snapshot" Agents="Agents" Resources="Resources" Expanded="expanded" Toggle="OnToggle" Edit="Edit" Add="Add" Delete="Delete" AttachResources="AttachResources" Disabled="Disabled" />
	}
</div>
@code {
	[Parameter, EditorRequired] public ProjectSnapshot Snapshot { get; set; } = default!;
	[Parameter] public IReadOnlyList<AgentProfile> Agents { get; set; } = [];
	[Parameter] public IReadOnlyList<ResourceProfile> Resources { get; set; } = [];
	[Parameter] public EventCallback<PlanItem> Edit { get; set; }
	[Parameter] public EventCallback<PlanItem> Delete { get; set; }
	[Parameter] public EventCallback<(string Kind, Guid? ParentId)> Add { get; set; }
	[Parameter] public EventCallback<Guid> AttachResources { get; set; }
	[Parameter] public bool Disabled { get; set; }
	private readonly HashSet<Guid> expanded = [];
	private Guid initializedProject;
	private Guid? activeId;
	protected override void OnParametersSet()
	{
		if (initializedProject != Snapshot.Id) { expanded.Clear(); initializedProject = Snapshot.Id; activeId = null; }
		PlanItem? active = Snapshot.Items.FirstOrDefault(item => item.Kind == "Step" && item.Status is "InProgress" or "Blocked");
		if (active is not null && activeId != active.Id)
		{
			activeId = active.Id;
			Guid? id = active.Id;
			for (int depth=0; depth<Snapshot.Items.Count && id.HasValue; depth++)
			{
				expanded.Add(id.Value);
				id = Snapshot.Items.FirstOrDefault(item => item.Id == id)?.ParentId;
			}
		}
	}
	private void OnToggle(Guid id) { if (!expanded.Add(id)) expanded.Remove(id); }
}
