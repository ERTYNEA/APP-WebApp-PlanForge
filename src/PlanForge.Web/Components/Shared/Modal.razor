@inject Microsoft.JSInterop.IJSRuntime JavaScript
<dialog @ref="dialog" class="modal" aria-label="@T[Title]" @oncancel="OnCancelAsync">
	<div class="modal-heading"><h2>@T[Title]</h2><button type="button" class="quiet" @onclick="Close" aria-label="@T["Close dialog"]">×</button></div>
	<CascadingValue Name="ModalError" Value="Error">@ChildContent</CascadingValue>
</dialog>
@code {
	[Parameter] public string Title { get; set; } = "";
	[Parameter] public string? Error { get; set; }
	[Parameter] public EventCallback Close { get; set; }
	[Parameter] public RenderFragment? ChildContent { get; set; }
	private ElementReference dialog;
	protected override async Task OnAfterRenderAsync(bool firstRender) { if (firstRender) await JavaScript.InvokeVoidAsync("planForge.openDialog",dialog); }
	private Task OnCancelAsync(EventArgs args) => Close.InvokeAsync();
}
