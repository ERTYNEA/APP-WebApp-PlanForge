<Modal Title="@Title" Error="@Error" Close="Close">
	<p class="user-text">@T[Description]</p>
	<p class="warning">@T["This action is irreversible from PlanForge."]</p>
	<label class="check-label"><input id="confirm-intent" type="checkbox" @bind="confirmed" /> @T["I understand and confirm this action."]</label>
	<div class="form-actions"><button type="button" class="quiet" @onclick="Close" disabled="@Busy">@T["Cancel"]</button><button id="confirm-delete" class="danger" @onclick="Confirm" disabled="@(!confirmed || Busy)">@T[ConfirmLabel ?? Title]</button></div>
</Modal>
@code {
	[Parameter] public string? ConfirmLabel { get; set; }
	[Parameter] public string Title { get; set; }="Confirm deletion";
	[Parameter] public string Description { get; set; }="";
	[Parameter] public string? Error { get; set; }
	[Parameter] public bool Busy { get; set; }
	[Parameter] public EventCallback Close { get; set; }
	[Parameter] public EventCallback Confirm { get; set; }
	private bool confirmed;
}
