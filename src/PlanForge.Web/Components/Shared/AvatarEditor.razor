@inherits ApiPage
<Feedback />
<div class="avatar-editor">
	<AvatarImage ApiPath="@(Deferred ? "" : ApiPath)" ImageUrl="@ImageUrl" Name="@Name" InitialHasAvatar="current.HasAvatar" InitialVersion="current.Version" Class="large" StateChanged="OnStateChanged" />
	<form @onsubmit="OnUploadAsync" @onsubmit:preventDefault>
		<label>
			@T["Avatar (PNG, JPEG or WebP, maximum 4 MiB)"]
			<InputFile OnChange="OnFileSelectedAsync" accept="image/png,image/jpeg,image/webp" disabled="@(Disabled || Busy)" />
		</label>
		<FormError Message="@(Error ?? ExternalError)" UseModalError="false" Conflict="Conflict" />
		<div class="form-actions">
			@if (!Deferred)
			{
				@if (current.HasAvatar)
				{
					<button type="button" class="danger" @onclick="OnRemoveAsync" disabled="@(Disabled || Busy)" aria-label="@T["Remove avatar"]">@T["Remove avatar"]</button>
				}
				<button class="quiet" disabled="@(Disabled || Busy || file is null)">@T["Upload avatar"]</button>
			}
			else
			{
				<p class="muted small">@T["Optional. The selected avatar is uploaded after the agent is saved."]</p>
			}
		</div>
	</form>
</div>
